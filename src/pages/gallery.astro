---
import Layout from '../layouts/Layout.astro';
import MagicalText from '../components/MagicalText';
import GalleryMouseStamps from '../components/GalleryMouseStamps';
import { readdir } from 'fs/promises';
import { join } from 'path';

const planetColor = '#8C7853'; // Mercury
const planetColorRgb = '140, 120, 83';

// Dynamically scan the gallery folder for images at build time
// Supports: jpg, jpeg, png, heic (note: HEIC files may not display in all browsers)
let imageSources: string[] = [];
try {
  const galleryPath = join(process.cwd(), 'public', 'gallery');
  const files = await readdir(galleryPath);
  const imageExtensions = ['.jpg', '.jpeg', '.png', '.heic', '.JPG', '.JPEG', '.PNG', '.HEIC'];
  imageSources = files
    .filter(file => imageExtensions.some(ext => file.endsWith(ext)))
    .map(file => `/gallery/${file}`)
    .sort(); // Sort alphabetically for consistent ordering
} catch (error) {
  // Fallback to placeholder images if gallery folder doesn't exist
  console.warn('Gallery folder not found, using placeholder images');
  imageSources = [];
}
---

<Layout title="gallery">
  <Fragment slot="head">
    {imageSources.slice(0, 5).map((src) => (
      <link rel="preload" as="image" href={src} fetchpriority="high" />
    ))}
    {imageSources.slice(5).map((src) => (
      <link rel="prefetch" as="image" href={src} />
    ))}
  </Fragment>
  <div class="h-screen relative overflow-hidden gallery-page" style="background: transparent;">
    <!-- Star background -->
    <div class="absolute inset-0 page-starfield"></div>
    <!-- Mercury color tint -->
    <div class="absolute inset-0 opacity-20 z-10" style={`background: radial-gradient(ellipse at center, rgba(${planetColorRgb}, 0.18), rgba(${planetColorRgb}, 0.05) 50%, transparent 80%);`}></div>

    <div class="max-w-7xl mx-auto px-10 py-24 relative z-10">
      <div class="max-w-6xl animate-fade-in">
        <div class="border-l-4 pl-6 mb-8" style="border-color: rgba(140, 120, 83, 0.4);">
          <h1 class="text-3xl font-medium mb-4 lowercase tracking-tight">
            <MagicalText text="gallery" color={planetColor} colorRgb={planetColorRgb} client:load />
          </h1>
          <div class="h-px w-24 mb-6" style="background: linear-gradient(to right, rgba(140, 120, 83, 0.6), transparent);"></div>
        </div>

      </div>
    </div>

    <GalleryMouseStamps imageSources={imageSources} client:load />
    <div class="page-tip"><div class="page-tip-text">move around!</div></div>
  </div>
</Layout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out;
  }
</style>
